# Copy to .env (gitignored). scripts/provision.ps1 and the setup scripts fill these in automatically.

# --- Azure ---
# Optional per-project Azure CLI profile, so `az account set` in other projects can't redirect this demo.
# One-time setup: $env:AZURE_CONFIG_DIR="$env:LOCALAPPDATA\caldova-demo-azure"; az login; az account set -s <subscription>
AZURE_CONFIG_DIR=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-caldova-foundry-demo

# --- Foundry ---
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_ACCOUNT_ARM_ID=
FOUNDRY_PROJECT_NAME=caldova-control-tower
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/caldova-control-tower
FOUNDRY_PROJECT_ARM_ID=
FOUNDRY_PROJECT_PRINCIPAL_ID=
ACR_NAME=
ACR_LOGIN_SERVER=
ACR_RESOURCE_ID=
APPINSIGHTS_NAME=
APPINSIGHTS_RESOURCE_ID=
LOG_ANALYTICS_WORKSPACE_ID=

# --- Models (deployment names) ---
COORDINATOR_MODEL_DEPLOYMENT=gpt-55
# anthropic -> claude-opus-55 ; openai -> gpt-54-mini (fallback)
ANALYST_MODEL_PROVIDER=anthropic
ANALYST_MODEL_DEPLOYMENT=claude-opus-55

# --- Agents ---
COORDINATOR_AGENT_NAME=caldova-coordinator
COORDINATOR_A2A_VERSION=
COORDINATOR_ORCHESTRATED_VERSION=
ANALYST_AGENT_NAME=caldova-logistics-analyst
ANALYST_AGENT_VERSION=
ANALYST_AGENT_PRINCIPAL_ID=
ANALYST_CONTAINER_IMAGE=
ANALYST_CANDIDATE_VERSION=
ANALYST_TOOLBOX_NAME=caldova-analyst-tools
ANALYST_TOOLBOX_VERSION=
ANALYST_TOOLBOX_TOOL=
COORDINATOR_AGENT_PRINCIPAL_ID=
A2A_CONNECTION_NAME=caldova-analyst-a2a
A2A_CONNECTION_ID=
VECTOR_STORE_ID=

# --- Local app ---
APP_PORT=8000
OTEL_SERVICE_NAME=caldova-control-tower-backend

# --- Evaluation (scripts/setup_evaluations.py) ---
EVAL_MODEL_DEPLOYMENT=gpt-54-mini
EVAL_MAX_HOURLY_RUNS=30
EVAL_SAMPLING_RATE=100
COORDINATOR_EVAL_ID=
ANALYST_EVAL_ID=
ANALYST_EVAL_DATASET_ID=
